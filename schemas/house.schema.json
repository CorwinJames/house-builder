{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corwinjames.github.io/house-builder/schemas/house.schema.json",
  "title": "House model",
  "description": "Source of truth for a House Builder design. Units are feet. Wall start/end are centerlines; thickness is centered on that segment. +x is east and +y is north. Do not store prices in this model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "sample",
    "disclaimer",
    "units",
    "footprint",
    "phases",
    "levels",
    "walls",
    "rooms",
    "openings",
    "roof"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 2,
      "description": "2 adds assemblies. 3 adds an optional cost block. 4 adds optional electrical devices. 5 adds optional plumbing fixtures. 6 adds an optional site block. 7 adds optional furniture, plan labels, site features, a per-room ground-level note, and optional areaKind and building on a room. 8 adds optional joins: which wall ends are clipped together. Older files still open; their touching ends count as clipped."
    },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "sample": {
      "type": "boolean",
      "description": "True when the file is a starting layout, not a final design."
    },
    "disclaimer": { "type": "string" },
    "units": { "const": "feet" },
    "location": { "$ref": "#/$defs/location" },
    "orientation": { "$ref": "#/$defs/orientation" },
    "footprint": { "$ref": "#/$defs/footprint" },
    "phases": { "$ref": "#/$defs/phases" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/level" }
    },
    "walls": {
      "type": "array",
      "items": { "$ref": "#/$defs/wall" }
    },
    "rooms": {
      "type": "array",
      "items": { "$ref": "#/$defs/room" }
    },
    "openings": {
      "type": "array",
      "items": { "$ref": "#/$defs/opening" }
    },
    "roof": { "$ref": "#/$defs/roof" },
    "constraints": {
      "type": "array",
      "description": "Length relationships. A target updates from its reference through the ratio. Stage 11 blueprint export must use these solved lengths, not a rounded substitute.",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "customRatios": {
      "type": "array",
      "items": { "$ref": "#/$defs/customRatio" }
    },
    "proportion": { "$ref": "#/$defs/proportion" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "joins": {
      "type": "array",
      "description": "Wall ends clipped together, so they move as one. Ends that touch but are not listed are only laid on. Missing in files before schema 8.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ends"],
        "properties": {
          "id": { "type": "string" },
          "ends": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["wall", "end"],
              "properties": {
                "wall": { "type": "string" },
                "end": { "enum": ["start", "end"] }
              }
            }
          }
        }
      }
    },
    "furniture": {
      "type": "array",
      "description": "Optional drawn icons: beds, counters, appliances, and similar. Not a price.",
      "items": { "$ref": "#/$defs/furniture" }
    },
    "planLabels": {
      "type": "array",
      "description": "Optional free-text notes placed on the plan.",
      "items": { "$ref": "#/$defs/planLabel" }
    },
    "siteFeatures": {
      "type": "array",
      "description": "Optional trees, ponds, pavilions, wind notes, and similar marks. Not a parcel survey.",
      "items": { "$ref": "#/$defs/siteFeature" }
    },
    "cost": { "$ref": "#/$defs/cost" },
    "electrical": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional. Devices, the panel, and per-wall wiring method. Schema 2 and 3 files omit it."
    },
    "plumbing": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional. Fixtures, water entry, septic stub, and supply method. Older files omit it."
    },
    "site": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional parcel, terrain, well, and septic. Older files omit it. Not a price."
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional targets for insulation the plan does not draw. Not a price.",
      "properties": {
        "ceilingR": { "type": "number" },
        "floorR": { "type": "number" },
        "note": { "type": "string" }
      }
    }
  },
  "$defs": {
    "point2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xAxis", "yAxis", "origin"],
      "properties": {
        "xAxis": { "const": "east" },
        "yAxis": { "const": "north" },
        "origin": { "type": "string" },
        "longAxis": { "enum": ["east-west", "north-south"] }
      }
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "longAxis"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "longAxis": { "enum": ["east-west", "north-south"] }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": { "type": "number" },
        "y0": { "type": "number" },
        "x1": { "type": "number" },
        "y1": { "type": "number" }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase1"],
      "properties": {
        "phase1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "bounds"],
          "properties": {
            "name": { "type": "string" },
            "bounds": { "$ref": "#/$defs/bounds" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "elevation", "plateHeight"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "elevation": { "type": "number" },
        "plateHeight": { "type": "number", "exclusiveMinimum": 0 },
        "floorThickness": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "levelId", "start", "end", "assembly", "assemblyId", "thickness", "height", "phase", "role"],
      "properties": {
        "id": { "type": "string" },
        "levelId": { "type": "string" },
        "start": { "$ref": "#/$defs/point2" },
        "end": { "$ref": "#/$defs/point2" },
        "assembly": { "enum": ["hempcrete", "rammed-earth", "framed"] },
        "assemblyId": {
          "type": "string",
          "description": "Key into data/assemblies.json. Thickness and framing come from that record."
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Feet, copied from the assembly. Centered on the start–end segment. Not typed by the user."
        },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "phase": { "enum": ["phase1", "future"] },
        "role": { "enum": ["exterior", "interior"] }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "levelId", "name", "phase", "polygon", "finish"],
      "properties": {
        "id": { "type": "string" },
        "levelId": { "type": "string" },
        "name": { "type": "string" },
        "phase": { "enum": ["phase1", "future"] },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "description": "Interior floor polygon, in order. Square feet come from this polygon.",
          "items": { "$ref": "#/$defs/point2" }
        },
        "finish": { "enum": ["wood", "tile", "stone", "concrete"] },
        "conditioned": { "type": "boolean" },
        "outdoor": { "type": "boolean" },
        "labelAt": { "$ref": "#/$defs/point2" },
        "note": { "type": "string" },
        "groundLevel": {
          "type": "string",
          "description": "A note such as higher ground or lowest ground. Not a measured elevation."
        },
        "areaKind": {
          "enum": ["heated", "covered", "site", "study"],
          "description": "heated counts in the heated area, the walls, and the roof. covered is a covered outdoor area, shown separately. site and study are drawn and are not built or priced."
        },
        "building": {
          "type": "string",
          "description": "Which building this room belongs to, such as main or studio. The main-house dimension uses main."
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wallId", "type", "offset", "width", "height", "sill", "header"],
      "properties": {
        "id": { "type": "string" },
        "wallId": { "type": "string" },
        "type": { "enum": ["door", "window"] },
        "style": { "enum": ["swing", "sliding", "cased", "overhead"] },
        "offset": {
          "type": "number",
          "minimum": 0,
          "description": "Feet from the wall start point to the opening's near jamb."
        },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "sill": { "type": "number", "minimum": 0 },
        "hinge": { "enum": ["start", "end"] },
        "swingSide": {
          "enum": ["left", "right"],
          "description": "Which side of the start→end direction the swing opens toward. Left is counterclockwise."
        },
        "header": { "$ref": "#/$defs/header" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetId", "referenceId", "ratioId", "operation"],
      "properties": {
        "id": { "type": "string" },
        "targetId": { "type": "string", "description": "Wall id, or footprint:width, or footprint:depth." },
        "referenceId": { "type": "string" },
        "ratioId": { "type": "string" },
        "operation": { "enum": ["multiply", "divide"] },
        "customValue": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "customRatio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "value"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "value": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "proportion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratioId", "module"],
      "properties": {
        "ratioId": { "type": "string" },
        "module": { "type": "number", "exclusiveMinimum": 0, "description": "Base module in feet for the ratio snap series." }
      }
    },
    "furniture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rotation": { "type": "number", "description": "Degrees counter-clockwise from east." },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "roomId": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "planLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "note": { "type": "string" }
      }
    },
    "siteFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["tree", "pond", "pavilion", "wind", "garden", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rotation": { "type": "number" },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "description": "Auto-sized from data/headers.json. Placeholder until Stage 7 and an engineer replace it.",
      "required": ["placeholder", "label", "depth", "height", "note"],
      "properties": {
        "placeholder": { "const": true },
        "label": { "type": "string" },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    },
    "roof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "placeholder", "pitch", "pitchRiseOverRun", "overhang", "plateHeight"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["chinese-hip-and-gable"] },
        "placeholder": { "type": "boolean" },
        "pitch": { "type": "string" },
        "pitchRiseOverRun": { "type": "number", "exclusiveMinimum": 0 },
        "overhang": { "type": "number", "minimum": 0 },
        "plateHeight": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional. Schema 2 files omit this. Bids and user entries replace a published price. DIY finish labor is $0 until hireFinish is used in the app.",
      "properties": {
        "diyFinish": { "type": "boolean" },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["priceId", "amount", "sourceType"],
            "properties": {
              "priceId": { "type": "string" },
              "amount": { "type": "number" },
              "sourceType": { "enum": ["bid", "user-entry"] },
              "note": { "type": "string" },
              "url": { "type": "string" },
              "date": { "type": "string" }
            }
          }
        },
        "rates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rate"],
            "properties": {
              "id": { "type": "string" },
              "rate": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
