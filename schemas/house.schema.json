{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corwinjames.github.io/house-builder/schemas/house.schema.json",
  "title": "House model",
  "description": "Source of truth for a House Builder design. Units are feet. Wall start/end are centerlines; thickness is centered on that segment. +x is east and +y is north. Do not store prices in this model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "sample",
    "disclaimer",
    "units",
    "footprint",
    "phases",
    "levels",
    "walls",
    "rooms",
    "openings",
    "roof"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 2,
      "description": "2 adds assemblies. 3 adds an optional cost block. 4 adds optional electrical devices. 5 adds optional plumbing fixtures. 6 adds an optional site block. 7 adds optional furniture, plan labels, site features, a per-room ground-level note, and optional areaKind and building on a room. 8 adds optional joins: which wall ends are clipped together. Older files still open; their touching ends count as clipped."
    },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "sample": {
      "type": "boolean",
      "description": "True when the file is a starting layout, not a final design."
    },
    "disclaimer": { "type": "string" },
    "units": { "const": "feet" },
    "location": { "$ref": "#/$defs/location" },
    "orientation": { "$ref": "#/$defs/orientation" },
    "footprint": { "$ref": "#/$defs/footprint" },
    "phases": { "$ref": "#/$defs/phases" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/level" }
    },
    "walls": {
      "type": "array",
      "items": { "$ref": "#/$defs/wall" }
    },
    "rooms": {
      "type": "array",
      "items": { "$ref": "#/$defs/room" }
    },
    "openings": {
      "type": "array",
      "items": { "$ref": "#/$defs/opening" }
    },
    "roof": { "$ref": "#/$defs/roof" },
    "constraints": {
      "type": "array",
      "description": "Length relationships. A target updates from its reference through the ratio. Stage 11 blueprint export must use these solved lengths, not a rounded substitute.",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "customRatios": {
      "type": "array",
      "items": { "$ref": "#/$defs/customRatio" }
    },
    "proportion": { "$ref": "#/$defs/proportion" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "joins": {
      "type": "array",
      "description": "Wall ends clipped together, so they move as one. Ends that touch but are not listed are only laid on. Missing in files before schema 8.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ends"],
        "properties": {
          "id": { "type": "string" },
          "ends": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["wall", "end"],
              "properties": {
                "wall": { "type": "string" },
                "end": { "enum": ["start", "end"] }
              }
            }
          }
        }
      }
    },
    "furniture": {
      "type": "array",
      "description": "Optional drawn icons: beds, counters, appliances, and similar. Not a price.",
      "items": { "$ref": "#/$defs/furniture" }
    },
    "solar": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional passive-solar settings: a reference place when the plan has no real lot, the climate for overhang sizing, and what solar collectors on the roof would be for.",
      "properties": {
        "place": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "lat", "lon"],
          "properties": {
            "name": { "type": "string" },
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "climate": {
          "type": "object",
          "additionalProperties": false,
          "description": "Average heating degree days (base 65 °F) and cooling degree days (base 75 °F) a year, from daily mean temperatures.",
          "properties": {
            "hdd65": { "type": "number", "minimum": 0 },
            "cdd75": { "type": "number", "minimum": 0 },
            "years": { "type": "string" },
            "lat": { "type": "number" },
            "lon": { "type": "number" },
            "source": { "type": "string" },
            "url": { "type": "string" },
            "checked": { "type": "string" }
          }
        },
        "climateChoice": { "enum": ["auto", "cold", "moderate", "hot"] }
      }
    },
    "skylights": {
      "type": "array",
      "description": "Optional skylights: glass in the roof over a room. x, y is the middle of the opening on the plan; width and depth are in feet. Allowed in version 8 files.",
      "items": { "$ref": "#/$defs/skylight" }
    },
    "planLabels": {
      "type": "array",
      "description": "Optional free-text notes placed on the plan.",
      "items": { "$ref": "#/$defs/planLabel" }
    },
    "columns": {
      "type": "array",
      "description": "Optional free-standing posts: timber columns of a veranda, a gallery, or an open hall. Height runs from the floor to the roof plate.",
      "items": { "$ref": "#/$defs/column" }
    },
    "images": {
      "type": "array",
      "description": "Optional pictures on the plan (pasted from Affinity Designer, dropped, or added from the File menu), drawn under the walls. src is a data URL. lines are a pasted SVG's straight lines, normalized [u1, v1, u2, v2] across and down the picture, for tracing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "width", "height", "src"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "x": { "type": "number", "description": "Middle of the picture, plan feet." },
          "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "rotation": { "type": "number", "description": "Degrees counter-clockwise." },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "scaled": { "type": "boolean", "description": "True once its scale was set from a known length or a typed width." },
          "src": { "type": "string" },
          "pxWidth": { "type": "number" },
          "pxHeight": { "type": "number" },
          "lines": { "type": "array", "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } } }
        }
      }
    },
    "buildings": {
      "type": "object",
      "description": "Optional settings per building, keyed by the building name used on rooms. A building with no entry uses the house roof.",
      "additionalProperties": { "$ref": "#/$defs/building" }
    },
    "siteFeatures": {
      "type": "array",
      "description": "Optional trees, ponds, pavilions, wind notes, and similar marks. Not a parcel survey.",
      "items": { "$ref": "#/$defs/siteFeature" }
    },
    "cost": { "$ref": "#/$defs/cost" },
    "electrical": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional. Devices, the panel, and per-wall wiring method. Schema 2 and 3 files omit it."
    },
    "plumbing": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional. Fixtures, water entry, septic stub, and supply method. Older files omit it."
    },
    "site": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional parcel, terrain, well, and septic. Older files omit it. Not a price."
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional targets for insulation the plan does not draw. Not a price.",
      "properties": {
        "ceilingR": { "type": "number" },
        "floorR": { "type": "number" },
        "note": { "type": "string" }
      }
    }
  },
  "$defs": {
    "skylight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "depth"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number", "description": "Middle of the ceiling opening, plan feet." },
        "y": { "type": "number" },
        "model": { "enum": ["C01", "C04", "C06", "M02", "M04", "M06", "S06"], "description": "VELUX FS deck-mount size code. Sets the rough opening." },
        "width": { "type": "number", "exclusiveMinimum": 0, "description": "Ceiling opening across the slope, feet (written from the model)." },
        "depth": { "type": "number", "exclusiveMinimum": 0, "description": "Ceiling opening down the slope as seen from above, feet (written from the model and the pitch)." },
        "rotation": { "type": "number", "description": "Degrees counter-clockwise from east. 90 when the roof face slopes east or west." },
        "roomId": { "type": "string" },
        "phase": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "point2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xAxis", "yAxis", "origin"],
      "properties": {
        "xAxis": { "const": "east" },
        "yAxis": { "const": "north" },
        "origin": { "type": "string" },
        "longAxis": { "enum": ["east-west", "north-south"] }
      }
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "longAxis"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "longAxis": { "enum": ["east-west", "north-south"] }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": { "type": "number" },
        "y0": { "type": "number" },
        "x1": { "type": "number" },
        "y1": { "type": "number" }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase1"],
      "properties": {
        "phase1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "bounds"],
          "properties": {
            "name": { "type": "string" },
            "bounds": { "$ref": "#/$defs/bounds" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "elevation", "plateHeight"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "elevation": { "type": "number" },
        "plateHeight": { "type": "number", "exclusiveMinimum": 0 },
        "floorThickness": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "levelId", "start", "end", "assembly", "assemblyId", "thickness", "height", "phase", "role"],
      "properties": {
        "id": { "type": "string" },
        "levelId": { "type": "string" },
        "start": { "$ref": "#/$defs/point2" },
        "end": { "$ref": "#/$defs/point2" },
        "assembly": { "enum": ["hempcrete", "rammed-earth", "framed", "timber-infill", "brick", "screen"] },
        "assemblyId": {
          "type": "string",
          "description": "Key into data/assemblies.json. Thickness and framing come from that record."
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Feet, copied from the assembly. Centered on the start–end segment. Not typed by the user."
        },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "phase": { "enum": ["phase1", "future"] },
        "role": { "enum": ["exterior", "interior"] }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "levelId", "name", "phase", "polygon", "finish"],
      "properties": {
        "id": { "type": "string" },
        "levelId": { "type": "string" },
        "name": { "type": "string" },
        "phase": { "enum": ["phase1", "future"] },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "description": "Interior floor polygon, in order. Square feet come from this polygon.",
          "items": { "$ref": "#/$defs/point2" }
        },
        "finish": { "enum": ["wood", "tile", "stone", "concrete"] },
        "conditioned": { "type": "boolean" },
        "outdoor": { "type": "boolean" },
        "labelAt": { "$ref": "#/$defs/point2" },
        "note": { "type": "string" },
        "groundLevel": {
          "type": "string",
          "description": "A note such as higher ground or lowest ground. Not a measured elevation."
        },
        "areaKind": {
          "enum": ["heated", "covered", "site", "study"],
          "description": "heated counts in the heated area, the walls, and the roof. covered is a covered outdoor area, shown separately. site and study are drawn and are not built or priced."
        },
        "building": {
          "type": "string",
          "description": "Which building this room belongs to, such as main or studio. The main-house dimension uses main. Each building gets its own roof."
        },
        "floorLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 12,
          "description": "Top of the finished floor above grade, feet. 0 or missing is on grade. A raised wooden floor (Korean maru, Japanese engawa or tatami rooms) or a room on a building platform."
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wallId", "type", "offset", "width", "height", "sill", "header"],
      "properties": {
        "id": { "type": "string" },
        "wallId": { "type": "string" },
        "type": { "enum": ["door", "window"] },
        "style": { "enum": ["swing", "sliding", "cased", "overhead", "folding"], "description": "Doors: swing, sliding glass, cased (open), overhead (garage), or folding glass panels that stack to one side." },
        "offset": {
          "type": "number",
          "minimum": 0,
          "description": "Feet from the wall start point to the opening's near jamb."
        },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "sill": { "type": "number", "minimum": 0 },
        "hinge": { "enum": ["start", "end"] },
        "swingSide": {
          "enum": ["left", "right"],
          "description": "Which side of the start→end direction the swing opens toward. Left is counterclockwise."
        },
        "awning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["depth", "gap"],
          "description": "Optional fixed horizontal shade over a window, on the outside face of the wall.",
          "properties": {
            "depth": { "type": "number", "exclusiveMinimum": 0, "description": "How far it sticks out from the wall face, feet." },
            "gap": { "type": "number", "minimum": 0, "description": "Its underside above the window head, feet." },
            "extend": { "type": "number", "minimum": 0, "description": "How far it runs past each side of the window, feet." }
          }
        },
        "header": { "$ref": "#/$defs/header" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetId", "referenceId", "ratioId", "operation"],
      "properties": {
        "id": { "type": "string" },
        "targetId": { "type": "string", "description": "Wall id, or footprint:width, or footprint:depth." },
        "referenceId": { "type": "string" },
        "ratioId": { "type": "string" },
        "operation": { "enum": ["multiply", "divide"] },
        "customValue": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "customRatio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "value"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "value": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "proportion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratioId", "module"],
      "properties": {
        "ratioId": { "type": "string" },
        "module": { "type": "number", "exclusiveMinimum": 0, "description": "Base module in feet for the ratio snap series." }
      }
    },
    "furniture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rotation": { "type": "number", "description": "Degrees counter-clockwise from east." },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "roomId": { "type": "string" },
        "note": { "type": "string" },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "id"],
          "description": "A furnishing that is also a plumbing fixture or an electrical device (its furnitureId points back). Kept in step by syncFurnishings.",
          "properties": {
            "system": { "enum": ["plumbing", "electrical"] },
            "id": { "type": "string" }
          }
        }
      }
    },
    "planLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "note": { "type": "string" }
      }
    },
    "siteFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["tree", "pond", "pavilion", "wind", "garden", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rotation": { "type": "number" },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "description": "Auto-sized from data/headers.json. Placeholder until Stage 7 and an engineer replace it.",
      "required": ["placeholder", "label", "depth", "height", "note"],
      "properties": {
        "placeholder": { "const": true },
        "label": { "type": "string" },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "size"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "size": { "type": "number", "exclusiveMinimum": 0, "description": "Diameter, or side for a square post, feet." },
        "shape": { "enum": ["round", "square"] },
        "phase": { "enum": ["phase1", "future"] },
        "building": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "building": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "style": { "enum": ["hip-and-gable", "hip", "gable", "flush-gable"] },
        "ridge": { "enum": ["auto", "east-west", "north-south"] },
        "curve": { "type": "number", "minimum": 0, "maximum": 1 },
        "pitch": { "type": "number", "exclusiveMinimum": 0, "description": "Rise per foot of run for this building's roof (1 is 12:12, a steep thatch). Missing uses the house pitch." },
        "platform": { "type": "number", "minimum": 0, "maximum": 12, "description": "Height of a raised stone and earth platform under the building, feet. 0 or missing is none." },
        "template": { "type": "string", "description": "Which template placed this building, if any." }
      }
    },
    "roof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "placeholder", "pitch", "pitchRiseOverRun", "overhang", "plateHeight"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["chinese-hip-and-gable"] },
        "placeholder": { "type": "boolean" },
        "pitch": { "type": "string" },
        "pitchRiseOverRun": { "type": "number", "exclusiveMinimum": 0 },
        "overhang": { "type": "number", "minimum": 0 },
        "eaves": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional eave overhang on each side, feet past the walls. When set it replaces overhang for both phases.",
          "properties": {
            "south": { "type": "number", "minimum": 0 },
            "north": { "type": "number", "minimum": 0 },
            "east": { "type": "number", "minimum": 0 },
            "west": { "type": "number", "minimum": 0 }
          }
        },
        "style": { "enum": ["hip-and-gable", "hip", "gable", "flush-gable"], "description": "Roof form. Hip and gable (Chinese xieshan, Japanese irimoya, Korean paljak). Hip (wudian, yosemune, ujingak). Gable with the roof running past the end walls (xuanshan, kirizuma, matbae). Flush gable, ends cut at the end walls (yingshan). Missing is hip and gable." },
        "ridge": { "enum": ["auto", "east-west", "north-south"], "description": "Which way the ridge runs. auto runs it along the longer side." },
        "curve": { "type": "number", "minimum": 0, "maximum": 1, "description": "0 is a straight roof. Above 0 the slopes sag and the eave corners turn up, as on Chinese and Korean roofs. 1 is the strongest." },
        "plateHeight": { "type": "number", "exclusiveMinimum": 0 },
        "clerestory": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional stepped roof over the main building: a low roof in front, a band of high glass, and a raised roof behind.",
          "properties": {
            "face": { "enum": ["south", "north"], "description": "Which way the glass looks." },
            "setback": { "type": "number", "minimum": 0, "description": "Feet from the outer face of the front wall back to the glass. 0 means 40% of the way back." },
            "glass": { "type": "number", "exclusiveMinimum": 0, "description": "Height of the glass band, feet." },
            "eave": { "type": "number", "minimum": 0, "description": "How far the high roof sticks out over the glass, feet." },
            "lowPitch": { "type": "number", "exclusiveMinimum": 0, "description": "Rise per foot of the low roof in front (0.25 is 3:12)." }
          }
        },
        "note": { "type": "string" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional. Schema 2 files omit this. Bids and user entries replace a published price. DIY finish labor is $0 until hireFinish is used in the app.",
      "properties": {
        "diyFinish": { "type": "boolean" },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["priceId", "amount", "sourceType"],
            "properties": {
              "priceId": { "type": "string" },
              "amount": { "type": "number" },
              "sourceType": { "enum": ["bid", "user-entry"] },
              "note": { "type": "string" },
              "url": { "type": "string" },
              "date": { "type": "string" }
            }
          }
